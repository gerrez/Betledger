{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["laravel-boost"],
  "permissions": {
    "allow": [
      "mcp__laravel-boost__application-info",
      "mcp__laravel-boost__browser-logs",
      "mcp__laravel-boost__database-connections",
      "mcp__laravel-boost__database-query",
      "mcp__laravel-boost__database-schema",
      "mcp__laravel-boost__get-absolute-url",
      "mcp__laravel-boost__last-error",
      "mcp__laravel-boost__read-log-entries",
      "mcp__laravel-boost__search-docs",
      "Bash(php artisan:*)",
      "Bash(composer install:*)",
      "Bash(composer require:*)",
      "Bash(composer remove:*)",
      "Bash(composer update:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(composer show:*)",
      "Bash(composer validate:*)",
      "Bash(composer run:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "ask": [
      "mcp__laravel-boost__tinker",
      "mcp__laravel-boost__record-rule",
      "Bash(php artisan tinker:*)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan migrate:reset:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./phpstan.neon)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --delete:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo:*)",
      "Bash(gh secret:*)",
      "Bash(gh api:*)",
      "Read(./.env.production)",
      "Read(./.env.backup)",
      "Read(./auth.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
